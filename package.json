{
  "name": "rp4-recorder",
  "version": "0.2.12",
  "productName": "RP4 Recorder",
  "description": "RP4 desktop game recorder",
  "author": "RP4",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "lint": "eslint src scripts",
    "lint:syntax": "node scripts/check-syntax.js",
    "smoke": "set ELECTRON_RUN_AS_NODE=&& set RP4_SMOKE=1&& electron .",
    "test:integration": "set ELECTRON_RUN_AS_NODE=&& electron scripts/integration-test.js",
    "test": "npm run lint && npm run smoke && npm run test:integration",
    "dist": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& set ELECTRON_BUILDER_DISABLE_BUILD_CACHE=true&& electron-builder --win --x64"
  },
  "build": {
    "appId": "com.rp4.recorder",
    "productName": "RP4 Recorder",
    "copyright": "Copyright © 2026 RP4",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "signExts": [
        "!"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RP4 Recorder"
    },
    "portable": {
      "artifactName": "RP4-Recorder-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
