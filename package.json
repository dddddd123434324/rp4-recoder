{
  "name": "rp4-recorder",
  "version": "0.3.0",
  "productName": "RP4 Recorder",
  "description": "RP4 desktop screen recorder",
  "author": "RP4",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/run-electron.js .",
    "lint": "eslint src scripts",
    "lint:syntax": "node scripts/check-syntax.js",
    "smoke": "node scripts/smoke-test.js",
    "smoke:packaged": "node scripts/packaged-smoke-test.js",
    "test:integration": "node scripts/run-electron.js scripts/integration-test.js",
    "test": "npm run lint && npm run smoke && npm run test:integration",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_BUILDER_DISABLE_BUILD_CACHE=true electron-builder --win --x64 && node scripts/write-checksums.js",
    "checksums": "node scripts/write-checksums.js"
  },
  "build": {
    "appId": "com.rp4.recorder",
    "productName": "RP4 Recorder",
    "copyright": "Copyright © 2026 RP4",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "icon.ico",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "signExts": [
        "!"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "RP4-Recorder-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "en_US",
        "ko_KR"
      ],
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RP4 Recorder"
    },
    "portable": {
      "artifactName": "RP4-Recorder-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^7.0.3",
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
